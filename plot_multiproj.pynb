        ref['grd'][list_mod_names[i]][var].plot(ax=ax2[0],
                      color=list_color[i],label=list_mod_names_l[i])
        #bs['grd'][list_mod_names[i]][var].cumsum().plot(ax=ax2[0],
        bs['grd'][list_mod_names[i]][var].plot(ax=ax2[0],
