    ax2[0].set_title("Grounded ice", fontsize=18)
    ax2[1].set_title("Ice shelves", fontsize=18)
    plt.tight_layout() 
    sns.despine()
    plt.show()
    fig.savefig(var+'_CMIP6.png',format='PNG', dpi=200)
    
    
