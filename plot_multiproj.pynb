    list_mod_names_l=['UKESM1-0-LL','CNRM-CM6-1','MPI-ESM1-2-HR','IPSL-CM6A-LR']
    list_color=['navy','goldenrod','firebrick','saddlebrown','darkslategrey']
    #list_color=['navy','goldenrod','firebrick','saddlebrown']
    
