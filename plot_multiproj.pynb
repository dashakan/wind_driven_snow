def plot_ablation(var):
    '''
    #Série temporelle grounded vs shelves pour SMB, ME, RU, SU, ER/SF
    '''
    #list_letter   = ['(a)','(b)'] 
    list_letter   = ['',''] 
    
    nrow=1
    ncol=2  
