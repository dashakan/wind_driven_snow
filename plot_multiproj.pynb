                      color=list_color[i],label=list_mod_names_l[i])
        #bs['shelf'][list_mod_names[i]][var].cumsum().plot(ax=ax2[1],
        bs['shelf'][list_mod_names[i]][var].plot(ax=ax2[1],
                      color=list_color[i],linestyle='dashed')

         
